{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-app.invalid/schema/questions.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "field": {
        "type": "integer",
        "minimum": 1
      },
      "type": {
        "type": "string",
        "enum": [
          "singleChoice",
          "multipleChoice"
        ]
      },
      "competency": {
        "type": "string",
        "minLength": 1
      },
      "family": {
        "type": "string",
        "minLength": 1
      },
      "topic": {
        "type": "string",
        "minLength": 1
      },
      "objective": {
        "type": "string",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "minLength": 0
      },
      "prompt": {
        "type": "string",
        "minLength": 1
      },
      "options": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "text",
            "explanation"
          ],
          "additionalProperties": false
        },
        "minItems": 2
      },
      "correctIDs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "explanation": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https://[^\\s]+$"
            }
          },
          "required": [
            "title",
            "url"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "approved": {
        "type": "boolean"
      },
      "reviewedOn": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "reviewedBy": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "approvalBasis": {
        "type": "string",
        "minLength": 0
      },
      "approvalConfirmedOn": {
        "type": "string",
        "minLength": 0
      },
      "approvalConfirmedBy": {
        "type": "string",
        "minLength": 0
      }
    },
    "required": [
      "id",
      "version",
      "field",
      "type",
      "competency",
      "family",
      "topic",
      "objective",
      "context",
      "prompt",
      "options",
      "correctIDs",
      "explanation",
      "sources",
      "approved"
    ],
    "additionalProperties": false
  },
  "minItems": 1,
  "maxItems": 10000
}
