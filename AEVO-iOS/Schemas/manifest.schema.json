{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-app.invalid/schema/manifest.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "generatedOn": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "writtenExam",
          "flashcards",
          "practicePreparation",
          "oralExam",
          "scenarioTraining"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "rightsNotice": {
      "type": "string",
      "minLength": 1
    },
    "legacyBackupFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "title",
    "description",
    "locale",
    "generatedOn",
    "categories",
    "modules",
    "rightsNotice",
    "legacyBackupFormats"
  ],
  "additionalProperties": false
}
